# Database - a local SQLite file for development
DATABASE_URL="file:./dev.db"
# Only needed for a hosted libSQL / Turso database
DATABASE_AUTH_TOKEN=""

# Secret used to sign login sessions - change this to a long random string
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# AI - add ONE key. Leave both empty to run in DEMO MODE (AI features return sample answers).
# Google Gemini: free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.8-flash"
# Anthropic Claude: key at https://console.anthropic.com
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5-5"
# Optional: force a provider when both keys are set ("gemini" or "anthropic")
AI_PROVIDER=""
